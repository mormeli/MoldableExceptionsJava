<idea-plugin>
    <id>ch.moldexj.exceptions</id>
    <name>Moldable Exceptions</name>
    <vendor>Moldable exceptions prototype</vendor>

    <description><![CDATA[
    Lets Java exceptions decide how they are debugged: methods annotated with <code>@DebugView</code> contribute
    text, diff and table views, shown when the debugger stops on the exception or via
    <b>Show Moldable Views</b> in the Variables view. A prototype of moldable exceptions
    (Chiş, Nierstrasz, Gîrba, Onward! 2024; Glamorous Toolkit by feenk).
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.java</depends>

    <projectListeners>
        <listener class="ch.moldexj.debugger.MoldableExceptionDebuggerManagerListener"
                  topic="com.intellij.xdebugger.XDebuggerManagerListener"/>
    </projectListeners>

    <actions>
        <action id="AssertBreakdown" class="ch.moldexj.action.AssertBreakdownAction"
                text="Break Down Assert">
            <add-to-group group-id="XDebugger.Frames.Tree.Popup" anchor="last"/>
        </action>
        <action id="Moldable.ShowViews"
                class="ch.moldexj.action.ShowMoldableViewsAction"
                text="Show Moldable Views"
                description="Show the views the selected exception declares with @DebugView, plus its causes">
            <add-to-group group-id="XDebugger.ValueGroup" anchor="first"/>
        </action>

        <group id="Moldable.RunMenu" text="Moldable Exceptions" popup="false">
            <separator/>
            <action id="Moldable.StopOnUncaught"
                    class="ch.moldexj.action.StopOnUncaughtToggleAction"
                    text="Moldable: Stop at Uncaught Moldable Exceptions"
                    description="Stop at the throw of an uncaught exception whose chain has views, without any breakpoint"/>
            <action id="Moldable.AutoOpen"
                    class="ch.moldexj.action.AutoOpenToggleAction"
                    text="Moldable: Open Views at Exception Breakpoints"
                    description="Open the moldable views automatically when the debugger stops on a moldable exception"/>
            <add-to-group group-id="RunMenu" anchor="last"/>
        </group>

        <!-- Toolbar of the PDF diff view (PdfDiffPanel). -->
        <group id="Moldable.PdfDiff.Toolbar">
            <action id="Moldable.PdfDiff.PreviousPage" class="ch.moldexj.view.pdf.actions.PreviousPageAction"
                    text="Previous Changed Page" icon="AllIcons.Actions.PreviousOccurence"/>
            <action id="Moldable.PdfDiff.NextPage" class="ch.moldexj.view.pdf.actions.NextPageAction"
                    text="Next Changed Page" icon="AllIcons.Actions.NextOccurence"/>
            <separator/>
            <action id="Moldable.PdfDiff.ZoomOut" class="ch.moldexj.view.pdf.actions.ZoomOutAction"
                    text="Zoom Out" icon="AllIcons.General.ZoomOut"/>
            <action id="Moldable.PdfDiff.ZoomIn" class="ch.moldexj.view.pdf.actions.ZoomInAction"
                    text="Zoom In" icon="AllIcons.General.ZoomIn"/>
            <action id="Moldable.PdfDiff.FitWidth" class="ch.moldexj.view.pdf.actions.FitWidthAction"
                    text="Fit Width" icon="AllIcons.General.FitContent"/>
            <action id="Moldable.PdfDiff.ActualSize" class="ch.moldexj.view.pdf.actions.ActualSizeAction"
                    text="Actual Size" icon="AllIcons.General.ActualZoom"/>
        </group>
    </actions>
</idea-plugin>
